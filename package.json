{
  "name": "maths-studio",
  "version": "0.1.0",
  "private": true,
  "main": "electron-main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron": "electron .",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "jsxgraph": "^1.14.3",
    "katex": "^0.19.1",
    "mathjs": "^15.2.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.mathsstudio.app",
    "productName": "Maths Studio",
    "asar": false,
    "files": [
      "electron-main.js",
      "package.json",
      ".next/**/*",
      "public/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
